<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wa_bg_light"
    android:orientation="vertical">

    <!-- Horizontal Scrollable Category Filter Chips matching Screenshots -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipPhoto"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip_selected"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/chip_photo"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipVideo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/chip_video"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipAudio"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/chip_audio"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipVoiceNote"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/chip_voice_note"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipDocument"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/chip_document"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipZip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/chip_zip"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipGif"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/chip_gif"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipSticker"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/chip_sticker"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView for Media Items -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            tools:listitem="@layout/item_media" />

        <!-- Empty State matching Screenshots -->
        <LinearLayout
            android:id="@+id/layoutEmptyMedia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivEmptyMediaIllustration"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_empty_photo" />

            <TextView
                android:id="@+id/tvEmptyMediaMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/empty_photo"
                android:textColor="@color/wa_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
