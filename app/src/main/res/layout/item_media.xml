<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/wa_card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Media Thumbnail / Icon Placeholder -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="#F0F4F1">

            <ImageView
                android:id="@+id/ivMediaThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivMediaTypeIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_empty_photo" />
        </FrameLayout>

        <!-- Media Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvMediaSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/wa_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Hiren Bhau" />

            <TextView
                android:id="@+id/tvMediaTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/wa_text_secondary"
                android:textSize="12sp"
                tools:text="17 Sep 2026, 12:40 PM" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
