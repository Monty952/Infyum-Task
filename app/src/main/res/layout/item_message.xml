<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMessageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- Message Bubble Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        app:cardBackgroundColor="@color/wa_bubble_incoming"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Sender Name (if in group/conversation) -->
            <TextView
                android:id="@+id/tvMessageSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Hiren Bhau"
                tools:visibility="visible" />

            <!-- Deleted Message Alert Banner -->
            <LinearLayout
                android:id="@+id/layoutDeletedAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_bubble_deleted"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_tool_wa_delete" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Recovered Deleted Message"
                    android:textColor="@color/wa_delete_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Image Preview -->
            <ImageView
                android:id="@+id/ivMediaPreview"
                android:layout_width="220dp"
                android:layout_height="180dp"
                android:layout_marginBottom="6dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Audio / Voice Note Playback Player Widget -->
            <LinearLayout
                android:id="@+id/layoutAudioPlayer"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/btnAudioPlayPause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_rounded_card"
                    android:padding="8dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/wa_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAudioLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voice Note"
                        android:textColor="@color/wa_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAudioStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to play"
                        android:textColor="@color/wa_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Message Text Content -->
            <TextView
                android:id="@+id/tvMessageContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wa_text_primary"
                android:textSize="15sp"
                tools:text="Ohkk bhai, check this out!" />

            <!-- Timestamp & Status -->
            <TextView
                android:id="@+id/tvMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:textColor="@color/wa_text_secondary"
                android:textSize="11sp"
                tools:text="12:40 PM" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
