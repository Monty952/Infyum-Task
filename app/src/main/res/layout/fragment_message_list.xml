<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wa_bg_light"
    android:orientation="vertical">

    <!-- Listener Service Status Indicator Bar -->
    <LinearLayout
        android:id="@+id/layoutServiceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ECFDF5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="#10B981" />

        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Notification Listener: Active &amp; Ready"
            android:textColor="#065F46"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSimulateTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_chip_unselected"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="+ Test Message"
            android:textColor="@color/wa_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Horizontal Category Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filterChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_filter_chip_selected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="All"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipFilterText"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Text"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFilterDeleted"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Deleted"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFilterPhoto"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Photos"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFilterVideo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Videos"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFilterVoice"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Voice Notes"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFilterVideoNote"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Video Notes"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFilterDocument"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Documents"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFilterSticker"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Stickers/GIFs"
                android:textColor="@color/wa_chip_text_unselected"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Captured Messages RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCapturedMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="4dp"
            tools:listitem="@layout/item_captured_message" />

        <!-- Empty State matching Screenshot -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_empty_bell" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/empty_deleted_messages_title"
                android:textColor="@color/wa_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/empty_deleted_messages_sub"
                android:textColor="@color/wa_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
